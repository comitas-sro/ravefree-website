{
  "name": "ravefree-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build && ./inline-css.mts && next-export-optimize-images",
    "code-quality": "concurrently -m 1 'npm run lint' 'npm run build'",
    "dev": "next dev",
    "format": "prettier --write .",
    "lint": "concurrently -m 1 'npm run lint:eslint' 'npm run lint:typescript'",
    "lint:eslint": "eslint --concurrency auto",
    "lint:typescript": "next typegen && tsc",
    "start": "next start"
  },
  "dependencies": {
    "@next/mdx": "^16.4.3",
    "next": "^16.4.3",
    "next-export-optimize-images": "npm:@elliott-w/next-export-optimize-images@^4.8.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "beasties": "^0.5.5",
    "concurrently": "^10.0.6",
    "eslint": "^10",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-mdx": "^3.8.2",
    "eslint-plugin-prettier": "^5.5.7",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.6.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    },
    "next-export-optimize-images": {
      "sharp": "^0.35.5"
    }
  }
}
